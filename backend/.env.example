# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file. NEVER put these keys in the frontend.
# ---------------------------------------------------------------------------

# --- Flask ----------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-me-in-production
PORT=8000
DEBUG=false

# --- Google Gemini (Google Gen AI SDK) ------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional: how many times to retry a failed AI call before falling back.
GEMINI_MAX_RETRIES=2

# --- Supabase -------------------------------------------------------------
# Project settings -> API
SUPABASE_URL=
SUPABASE_KEY=
# Optional (recommended): set to enable server-side JWT validation so that a
# trip can only be read/written by its owner.
SUPABASE_JWT_SECRET=
# Table used to persist trips (see ../supabase/schema.sql)
SUPABASE_Trips_TABLE=trips

# --- Local fallback storage ----------------------------------------------
# If Supabase is not configured, trips are stored in a local SQLite file so
# the application is fully functional during development.
LOCAL_DB_PATH=./data/trips.db
